{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "schedule:weekly",
        ":prConcurrentLimitNone",
        ":prHourlyLimitNone",
        ":semanticCommits",
        ":semanticCommitTypeAll(build)"
    ],
    "packageRules": [
        {
            "matchPackageNames": ["*"],
            "minimumReleaseAge": "7 days"
        },
        {
            "automerge": true,
            "matchCurrentVersion": "!/^0/",
            "matchUpdateTypes": ["minor", "patch"]
        },
        {
            "groupName": "dioxus monorepo",
            "matchSourceUrls": ["https://github.com/DioxusLabs/dioxus"]
        },
        {
            "groupName": "eslint",
            "matchDatasources": ["npm"],
            "matchPackageNames": [
                "@eslint/*",
                "@types/eslint-*",
                "@typescript-eslint/*",
                "eslint",
                "eslint-*",
                "!eslint-plugin-*",
                "typescript-eslint"
            ]
        },
        {
            "groupName": "hey-api monorepo",
            "matchSourceUrls": ["https://github.com/hey-api/openapi-ts"]
        },
        {
            "groupName": "leptos monorepo",
            "matchSourceUrls": ["https://github.com/leptos-rs/leptos"]
        },
        {
            "groupName": "mdbook monorepo",
            "matchSourceUrls": ["https://github.com/rust-lang/mdBook"]
        },
        {
            "groupName": "prettier",
            "matchDatasources": ["npm"],
            "matchPackageNames": ["@trivago/prettier-plugin-sort-imports", "prettier", "prettier-*"]
        },
        {
            "groupName": "rustcrypto",
            "matchSourceUrls": ["https://github.com/RustCrypto/**"]
        },
        {
            "groupName": "serde",
            "matchDatasources": ["crate"],
            "matchPackageNames": ["serde", "serde-*", "serde_*"]
        },
        {
            "groupName": "shield monorepo",
            "matchSourceUrls": ["https://github.com/RustForWeb/shield"]
        },
        {
            "groupName": "tower-sessions",
            "matchDatasources": ["crate"],
            "matchPackageNames": ["tower-sessions", "tower-sessions-*"]
        },
        {
            "groupName": "utoipa monorepo",
            "matchSourceUrls": ["https://github.com/juhaku/utoipa"]
        },
        {
            "groupName": "rustcrypto",
            "matchSourceUrls": ["https://github.com/RustCrypto/**"]
        },
        {
            "groupName": "tower-sessions",
            "matchDatasources": ["crate"],
            "matchPackageNames": ["tower-sessions", "tower-sessions-*"]
        },
        {
            "groupName": "yew monorepo",
            "matchSourceUrls": ["https://github.com/yewstack/yew"]
        },
        {
            "groupName": "vite",
            "matchDatasources": ["npm"],
            "matchPackageNames": ["@vitejs/*", "vite", "vite-*"]
        },
        {
            "groupName": "vitest",
            "matchDatasources": ["npm"],
            "matchPackageNames": ["@vitest/*", "vitest"]
        }
    ],
    "pre-commit": {
        "enabled": true
    }
}
